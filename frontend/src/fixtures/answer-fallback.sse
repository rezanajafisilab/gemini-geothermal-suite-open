data: {"type": "TEXT_MESSAGE_CONTENT", "timestamp": 1793260704555, "messageId": "d1e2f3a499", "delta": "In summer A1 still runs its doublet: the brine drives an absorption chiller "}

data: {"type": "TEXT_MESSAGE_CONTENT", "timestamp": 1793260704595, "messageId": "d1e2f3a499", "delta": "that makes the district's cold, so the wells stay busy 18.1% longer and "}

