data: {"type": "CUSTOM", "timestamp": 1793188245003, "name": "clarification", "value": {"kind": "offer", "generation_id": "8350ad35b7", "intro": "Write an adsorption chiller model?", "questions": [{"id": "generate", "label": "Write an adsorption chiller model?", "hint": "Writing and testing take one model call per attempt (at most three).", "options": ["Yes, write and test the model", "No, answer without it"], "default": "Yes, write and test the model", "required": true}], "details": {"component": "adsorption_chiller", "title": "Adsorption chiller", "inputs": ["drive_temp_c [°C]", "heat_available_mw [MW]", "cooling_water_temp_c [°C]", "chilled_water_temp_c [°C]"], "outputs": ["cold_mw [MW]", "drive_heat_mw [MW]", "rejected_heat_mw [MW]", "cop [-]", "min_drive_temp_c [°C]"], "physics": ["Kelvin temperatures: tg = drive_temp_c + 273.15, tc = cooling_water_temp_c + 273.15, te = chilled_water_temp_c + 273.15.", "Minimum drive temperature (characteristic equation, Kuehn and Ziegler 2005): min_drive_temp_c = 2 * cooling_water_temp_c - chilled_water_temp_c.", "Load fraction: load = (drive_temp_c - min_drive_temp_c) / 20, limited to 0 ... 1.", "drive_heat_mw = load * heat_available_mw.", "Carnot limit of a heat-driven chiller: cop_carnot = (1 - tc / tg) * te / (tc - te).", "cop = min(0.65, 0.4 * cop_carnot) when drive_heat_mw > 0, otherwise cop = 0.", "cold_mw = cop * drive_heat_mw.", "rejected_heat_mw = drive_heat_mw + cold_mw (energy balance)."], "sources": ["Herold, Radermacher and Klein (2016), Absorption Chillers and Heat Pumps, ch. 2: three-temperature Carnot COP.", "Hellmann, Schweigler and Ziegler (1999); Kuehn and Ziegler (2005): characteristic equation ΔΔt = t_G - a·t_AC + e·t_E; a = 2, e = 1 and 20 K at full load are plausible single-stage values, not fitted to a datasheet.", "cooling_design.md, section 2: silica gel-water chillers run on 55-90 °C water with COP 0.45-0.65."]}}}

