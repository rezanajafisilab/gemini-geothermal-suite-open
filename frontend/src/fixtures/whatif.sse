data: {"type": "TEXT_MESSAGE_CONTENT", "timestamp": 1793182838082, "messageId": "38d6542eff", "delta": "With the reservoir 10 °C colder, A1 still covers 100% of the heat, but the cost of heat moves from 41 to 47.2 €/MWh. The brine now gives 64.2% of the heat (was 78.1%) and the boiler 10.1% (was 2.5%); the CO₂ saving is 69.4% (was 82.2%)."}

data: {"type": "TEXT_MESSAGE_END", "timestamp": 1793182838082, "messageId": "38d6542eff"}

